# Writes ClassKeyCheck.inl for Mac/TypeNames/ClassKeyCheck.cpp
# (cmake -DMAPS=<PropertyMaps.inl> -DLIST=<DeclaredAsClass.inl> -DOUT=<file> -P MakeClassKeyCheck.cmake):
# one line for every type the property maps register, with the class key
# DeclaredAsClass.inl gives it. An entry of the list that names no registered
# type is an error: the list is only what the registered types need.

file(READ "${LIST}" list)
string(REGEX MATCHALL "BG3MSE_DECLARED_AS_CLASS\\([^)\n]+\\)" entries "${list}")
set(classes "")
foreach(entry IN LISTS entries)
    string(REGEX REPLACE "^BG3MSE_DECLARED_AS_CLASS\\((.*)\\)$" "\\1" name "${entry}")
    list(APPEND classes "${name}")
endforeach()
string(REGEX MATCHALL "BG3MSE_DECLARED_AS_CLASS_TEMPLATE\\([^)\n]+\\)" entries "${list}")
set(templates "")
foreach(entry IN LISTS entries)
    string(REGEX REPLACE "^BG3MSE_DECLARED_AS_CLASS_TEMPLATE\\((.*)\\)$" "\\1" name "${entry}")
    list(APPEND templates "${name}")
endforeach()

# BEGIN_CLS(<type>, <id>): the type is everything before the last comma. A
# type's text holds neither ';' nor brackets, so the lines can be a list.
file(STRINGS "${MAPS}" lines REGEX "^BEGIN_CLS(_TN)?\\(")
set(used "")
set(out "// Made by Mac/Tools/MakeClassKeyCheck.cmake from GameDefinitions/Generated/PropertyMaps.inl\n// and Mac/TypeNames/DeclaredAsClass.inl.\n")
set(count 0)
foreach(line IN LISTS lines)
    if(line MATCHES "^BEGIN_CLS_TN\\(")
        message(FATAL_ERROR "BEGIN_CLS_TN in ${MAPS}: this script reads BEGIN_CLS(<type>, <id>) only:\n${line}")
    endif()
    if(NOT line MATCHES "^BEGIN_CLS\\((.+), *[0-9]+\\)[ \t\r]*$")
        message(FATAL_ERROR "Not understood in ${MAPS}:\n${line}")
    endif()
    set(type "${CMAKE_MATCH_1}")
    string(REGEX REPLACE "<.*$" "" template "${type}")
    set(key "struct")
    if(type IN_LIST classes)
        set(key "class")
        list(APPEND used "${type}")
    elseif(NOT template STREQUAL type AND template IN_LIST templates)
        set(key "class")
        list(APPEND used "${template}")
    endif()
    string(APPEND out "BG3MSE_CHECK_KEY(${key}, ${type})\n")
    math(EXPR count "${count} + 1")
endforeach()
if(count EQUAL 0)
    message(FATAL_ERROR "${MAPS} registers no type")
endif()
foreach(name IN LISTS classes templates)
    if(NOT name IN_LIST used)
        message(FATAL_ERROR "${LIST} lists ${name}, which ${MAPS} does not register")
    endif()
endforeach()

set(current "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" current)
endif()
if(NOT current STREQUAL out)
    file(WRITE "${OUT}" "${out}")
endif()
